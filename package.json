{
  "name": "visapath-worker",
  "version": "1.0.0",
  "description": "VisaPath Cloudflare Worker — GOV.UK sponsor data + job API",
  "private": true,
  "scripts": {
    "dev"   : "wrangler dev",
    "deploy": "wrangler deploy",
    "sync"  : "curl -X POST https://visapath-worker.YOUR_SUBDOMAIN.workers.dev/api/sync -H 'Authorization: Bearer YOUR_SECRET'",
    "health": "curl https://visapath-worker.YOUR_SUBDOMAIN.workers.dev/api/health",
    "db:init"   : "wrangler d1 execute visapath-db --file=schema.sql",
    "db:console": "wrangler d1 execute visapath-db --command",
    "db:count"  : "wrangler d1 execute visapath-db --command=\"SELECT COUNT(*) FROM sponsors\""
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
